        "C1": { "$ref": "#/$defs/gateResult" },
        "C2": { "$ref": "#/$defs/gateResult" },
        "C3": { "$ref": "#/$defs/gateResult" },
        "C4": { "$ref": "#/$defs/gateResult" },
        "S1": { "$ref": "#/$defs/gateResult" },
        "S2": { "$ref": "#/$defs/gateResult" },
        "S3": { "$ref": "#/$defs/gateResult" },
        "S4": { "$ref": "#/$defs/gateResult" },
        "S5": { "$ref": "#/$defs/gateResult" },
        "Q1": { "$ref": "#/$defs/gateResult" },
        "Q2": { "$ref": "#/$defs/gateResult" },
        "Q3": { "$ref": "#/$defs/gateResult" }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gate_ids",
        "kind",
        "captured_at",
        "captured_by",
        "summary",
        "source_reference",
        "storage_reference",
        "sha256",
        "redacted",
        "access_class",
        "secret_material_included",
        "raw_private_log_included"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev-[a-z0-9][a-z0-9._-]*$"
        },
        "gate_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gateId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "HASH_RESULT",
            "VERSION_INVENTORY",
            "COMMAND_SUMMARY",
            "HTTP_SUMMARY",
            "SANITIZED_SCREENSHOT",
            "BACKUP_RESTORE_SUMMARY",
            "LOG_SUMMARY",
            "ACCESS_CONTROL_OBSERVATION",
            "OTHER_SANITIZED_SUMMARY"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "captured_by": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "storage_reference": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "redacted": {
          "type": "boolean"
        },
        "access_class": {
          "enum": [
            "PUBLIC_PROJECT_EVIDENCE",
            "RESTRICTED_OPERATIONAL_REFERENCE"
          ]
        },
        "secret_material_included": {
          "const": false
        },
        "raw_private_log_included": {
          "const": false
        }
      }
    },
    "logSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_start",
        "window_end",
        "sources",
        "warning_count",
        "fatal_count",
        "blocked_legitimate_request_count",
        "runtime_external_fetch_count",
        "redactions_performed",
        "secret_scan_status",
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "window_start": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "window_end": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "sources": {
          "type": "array",
          "items": {
            "enum": [
              "WORDPRESS_DEBUG_LOG",
              "PHP_LOG",
              "WEB_SERVER_LOG",
              "PROVIDER_EVENT_LOG",
              "WAF_LOG",
              "CDN_LOG",
              "PLUGIN_DIAGNOSTICS"
            ]
          },
          "uniqueItems": true
        },
        "warning_count": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "fatal_count": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "blocked_legitimate_request_count": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "runtime_external_fetch_count": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "redactions_performed": {
          "type": "boolean"
        },
        "secret_scan_status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "abort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggered",
        "trigger_codes",
        "observed_at",
        "writes_stopped",
        "journal_preserved",
        "ambiguous_records_retained",
        "restore_status",
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "triggered": {
          "type": "boolean"
        },
        "trigger_codes": {
          "type": "array",
          "items": {
            "enum": [
              "ARTIFACT_HASH_MISMATCH",
              "PROVENANCE_DRIFT",
              "PUBLIC_DOMAIN_MUTATION",
              "DNS_OR_DOMAIN_MUTATION",
              "GRAVATAR_MUTATION",
              "STAGING_EXPOSED_OR_INDEXABLE",
              "BACKUP_OR_RESTORE_UNAVAILABLE",
              "ADVISORY_LOCK_FAILURE",
              "PARTIAL_OR_AMBIGUOUS_IMPORT",
              "UNSAFE_ROLLBACK_DELETE",
              "SCIENTIFIC_META_WRITE_ACCEPTED",
              "EDITORIAL_FIELD_OVERWRITE",
              "RUNTIME_WARNING_OR_FATAL",
              "RUNTIME_EXTERNAL_FETCH",
              "SECURITY_CONTROL_REGRESSION",
              "SECRET_BEARING_EVIDENCE",
              "OTHER_BLOCKING_FAILURE"
            ]
          },
          "uniqueItems": true
        },
        "observed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "writes_stopped": {
          "type": "boolean"
        },
        "journal_preserved": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "ambiguous_records_retained": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "restore_status": {
          "enum": [
            "NOT_NEEDED",
            "NOT_RUN",
            "PASS",
            "FAIL",
            "MANUAL_REVIEW_REQUIRED"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "triggered": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "trigger_codes": {
                "minItems": 1
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "writes_stopped": {
                "const": true
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "trigger_codes": {
                "maxItems": 0
              },
              "observed_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "decided_at",
        "decided_by",
        "rationale",
        "open_blockers",
        "next_action",
        "production_activation_authorized",
        "separate_production_plan_required"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "GO",
            "NO-GO"
          ]
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "decided_by": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "open_blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "production_activation_authorized": {
          "const": false
        },
        "separate_production_plan_required": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "properties": {
              "purchase_state": {
                "const": "DEFERRED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "bootstrap_site_state": {
                "const": "NOT_PROVISIONED"
              },
              "staging_state": {
                "const": "NOT_PROVISIONED"
              },
              "bootstrap_url": {
                "type": "null"
              },
              "staging_url": {
                "type": "null"
              }
            }
          },
          "artifact": {
            "properties": {
              "verified_after_transfer": {
                "const": false
              },
              "observed_sha256": {
                "type": "null"
              },
              "sha256_recomputed_at": {
                "type": "null"
              },
              "target_copy_reference": {
                "type": "null"
              }
            }
          },
          "plugin": {
            "properties": {
              "installed": {
                "const": false
              },
              "active": {
                "const": false
              }
            }
          },
          "backup_restore": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              },
              "restore_demonstrated": {
                "const": false
              }
            }
          },
          "gates": {
            "patternProperties": {
              "^(E[1-5]|A[1-3]|I[1-8]|R[1-5]|T[1-4]|C[1-4]|S[1-5]|Q[1-3])$": {
                "properties": {
                  "status": {
                    "const": "NOT_RUN"
                  },
                  "target_host_observation": {
                    "const": false
                  }
                }
              }
            }
          },
          "decision": {
            "properties": {
              "verdict": {
                "const": "NO-GO"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "abort": {
            "properties": {
              "triggered": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "verdict": {
                "const": "NO-GO"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "verdict": {
                "const": "GO"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "purchase_state": {
                "const": "ACTIVE"
              },
              "bootstrap_site_state": {
                "const": "PROVISIONED"
              },
              "staging_state": {
                "const": "PROVISIONED"
              },
              "bootstrap_url": {
                "const": "https://observermultiversesresearch.wordpress.com/"
              },
              "staging_url": {
                "type": "string",
                "format": "uri"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "access": {
                "properties": {
                  "protected": {
                    "const": true
                  },
                  "search_engine_excluded": {
                    "const": true
                  }
                }
              }
            }
          },
          "artifact": {
            "properties": {
              "verified_after_transfer": {
                "const": true
              }
            }
          },
          "plugin": {
            "properties": {
              "installed": {
                "const": true
              },
              "active": {
                "const": true
              },
              "manifest_valid": {
                "const": true
              },
              "model_valid": {
                "const": true
              },
              "observed_work_count": {
                "const": 5
              }
            }
          },
          "production_safety": {
            "properties": {
              "observed_public_surface": {
                "const": "GRAVATAR_PROFILE"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "dns_changed": { "const": false },
              "nameservers_changed": { "const": false },
              "dnssec_changed": { "const": false },
              "domain_assignment_changed": { "const": false },
              "redirects_changed": { "const": false },
              "gravatar_surface_changed": { "const": false },
              "plugin_activated_on_public_domain": { "const": false },
              "research_published_outside_protected_staging": { "const": false },
              "pull_request_merged": { "const": false },
              "production_activation_attempted": { "const": false }
            }
          },
          "backup_restore": {
            "properties": {
              "status": {
                "const": "PASS"
              },
              "restore_demonstrated": {
                "const": true
              }
            }
          },
          "gates": {
            "patternProperties": {
              "^(E[1-5]|A[1-3]|I[1-8]|R[1-5]|T[1-4]|C[1-4]|S[1-5]|Q[1-3])$": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  },
                  "applicable": {
                    "const": true
                  },
                  "target_host_observation": {
                    "const": true
                  }
                }
              }
            }
          },
          "log_summary": {
            "properties": {
              "window_start": {
                "type": "string",
                "format": "date-time"
              },
              "window_end": {
                "type": "string",
                "format": "date-time"
              },
              "sources": {
                "minItems": 1
              },
              "warning_count": {
                "const": 0
              },
              "fatal_count": {
                "const": 0
              },
              "blocked_legitimate_request_count": {
                "const": 0
              },
              "runtime_external_fetch_count": {
                "const": 0
              },
              "secret_scan_status": {
                "const": "PASS"
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          },
          "abort": {
            "properties": {
              "triggered": {
                "const": false
              },
              "trigger_codes": {
                "maxItems": 0
              }
            }
          },
          "decision": {
            "properties": {
              "open_blockers": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
