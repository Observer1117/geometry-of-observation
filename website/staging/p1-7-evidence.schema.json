{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theobserverofmultiverses.info/schemas/p1-7-staging-evidence/1.0.0",
  "title": "Observer Research Registry P1.7 target-staging evidence",
  "description": "Strict evidence contract for the exact P1.6 candidate on the selected WordPress.com Business target-staging stack. This record never authorizes production.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "generated_at",
    "phase",
    "environment",
    "artifact",
    "plugin",
    "production_safety",
    "backup_restore",
    "gates",
    "evidence_items",
    "log_summary",
    "abort",
    "decision"
  ],
  "properties": {
    "schema_name": {
      "const": "observer-p1.7-staging-evidence"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^p1-7-[0-9]{8}-[0-9]{2,}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "const": "P1.7"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "plugin": {
      "$ref": "#/$defs/plugin"
    },
    "production_safety": {
      "$ref": "#/$defs/productionSafety"
    },
    "backup_restore": {
      "$ref": "#/$defs/backupRestore"
    },
    "gates": {
      "$ref": "#/$defs/gates"
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "log_summary": {
      "$ref": "#/$defs/logSummary"
    },
    "abort": {
      "$ref": "#/$defs/abort"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableUri": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableBoolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nullableNonNegativeInteger": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "gateStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "SKIP",
        "NOT_RUN"
      ]
    },
    "gateId": {
      "enum": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "A1",
        "A2",
        "A3",
        "I1",
        "I2",
        "I3",
        "I4",
        "I5",
        "I6",
        "I7",
        "I8",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "T1",
        "T2",
        "T3",
        "T4",
        "C1",
        "C2",
        "C3",
        "C4",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "Q1",
        "Q2",
        "Q3"
      ]
    },
    "inventoryComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "state",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/nullableString"
        },
        "state": {
          "enum": [
            "ACTIVE",
            "INACTIVE",
            "PRESENT",
            "UNKNOWN"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "selected_route",
        "purchase_state",
        "bootstrap_site_state",
        "staging_state",
        "planned_bootstrap_url",
        "bootstrap_url",
        "staging_url",
        "target_evidence_scope",
        "observed_at",
        "versions",
        "urls",
        "topology",
        "theme",
        "plugins",
        "mu_plugins",
        "drop_ins",
        "cache_layers",
        "network_layers",
        "access"
      ],
      "properties": {
        "provider": {
          "const": "WordPress.com"
        },
        "selected_route": {
          "const": "WORDPRESS_COM_BUSINESS"
        },
        "purchase_state": {
          "enum": [
            "DEFERRED",
            "ACTIVE"
          ]
        },
        "bootstrap_site_state": {
          "enum": [
            "NOT_PROVISIONED",
            "PROVISIONED"
          ]
        },
        "staging_state": {
          "enum": [
            "NOT_PROVISIONED",
            "PROVISIONED"
          ]
        },
        "planned_bootstrap_url": {
          "const": "https://observermultiversesresearch.wordpress.com/"
        },
        "bootstrap_url": {
          "oneOf": [
            {
              "const": "https://observermultiversesresearch.wordpress.com/"
            },
            {
              "type": "null"
            }
          ]
        },
        "staging_url": {
          "$ref": "#/$defs/nullableUri"
        },
        "target_evidence_scope": {
          "const": "TARGET_HOST_ONLY"
        },
        "observed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wordpress",
            "php",
            "php_sapi",
            "database_engine",
            "database_version",
            "web_server"
          ],
          "properties": {
            "wordpress": {
              "$ref": "#/$defs/nullableString"
            },
            "php": {
              "$ref": "#/$defs/nullableString"
            },
            "php_sapi": {
              "$ref": "#/$defs/nullableString"
            },
            "database_engine": {
              "oneOf": [
                {
                  "enum": [
                    "MySQL",
                    "MariaDB",
                    "OTHER",
                    "UNKNOWN"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "database_version": {
              "$ref": "#/$defs/nullableString"
            },
            "web_server": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "urls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "siteurl",
            "home",
            "permalink_structure"
          ],
          "properties": {
            "siteurl": {
              "$ref": "#/$defs/nullableUri"
            },
            "home": {
              "$ref": "#/$defs/nullableUri"
            },
            "permalink_structure": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "is_multisite",
            "https_only"
          ],
          "properties": {
            "is_multisite": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "https_only": {
              "$ref": "#/$defs/nullableBoolean"
            }
          }
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parent",
            "child"
          ],
          "properties": {
            "kind": {
              "oneOf": [
                {
                  "enum": [
                    "CLASSIC",
                    "HYBRID",
                    "BLOCK",
                    "UNKNOWN"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "parent": {
              "oneOf": [
                {
                  "$ref": "#/$defs/inventoryComponent"
                },
                {
                  "type": "null"
                }
              ]
            },
            "child": {
              "oneOf": [
                {
                  "$ref": "#/$defs/inventoryComponent"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventoryComponent"
          }
        },
        "mu_plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventoryComponent"
          }
        },
        "drop_ins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventoryComponent"
          }
        },
        "cache_layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventoryComponent"
          }
        },
        "network_layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventoryComponent"
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protected",
            "protection_method",
            "search_engine_excluded"
          ],
          "properties": {
            "protected": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "protection_method": {
              "$ref": "#/$defs/nullableString"
            },
            "search_engine_excluded": {
              "$ref": "#/$defs/nullableBoolean"
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "hash_algorithm",
        "required_sha256",
        "observed_sha256",
        "sha256_recomputed_at",
        "verified_after_transfer",
        "target_copy_reference",
        "repository",
        "pull_request",
        "pull_request_state",
        "pull_request_head",
        "pull_request_base_at_preflight",
        "bundled_registry_source_commit"
      ],
      "properties": {
        "file_name": {
          "const": "observer-research-registry-0.1.0.zip"
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "required_sha256": {
          "const": "0d29a680f9aa478d2da3167b64bdbd0570839b2fd7cf9168159e8d4317e3e3d7"
        },
        "observed_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "sha256_recomputed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "verified_after_transfer": {
          "type": "boolean"
        },
        "target_copy_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "repository": {
          "const": "Observer1117/geometry-of-observation"
        },
        "pull_request": {
          "const": "https://github.com/Observer1117/geometry-of-observation/pull/3"
        },
        "pull_request_state": {
          "const": "DRAFT_OPEN_UNMERGED"
        },
        "pull_request_head": {
          "const": "4e7dff23bb53056d559fe44fc43a74c55eb27b10"
        },
        "pull_request_base_at_preflight": {
          "const": "bab4480e50f8abe32087da765a145575a4519f8a"
        },
        "bundled_registry_source_commit": {
          "const": "bab4480e50f8abe32087da765a145575a4519f8a"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verified_after_transfer": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "observed_sha256": {
                "const": "0d29a680f9aa478d2da3167b64bdbd0570839b2fd7cf9168159e8d4317e3e3d7"
              },
              "sha256_recomputed_at": {
                "type": "string",
                "format": "date-time"
              },
              "target_copy_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "version",
        "registry_schema",
        "installed",
        "active",
        "manifest_valid",
        "model_valid",
        "management_capability",
        "post_type",
        "rest_base",
        "expected_work_count",
        "observed_work_count",
        "importer_state_digest"
      ],
      "properties": {
        "slug": {
          "const": "observer-research-registry"
        },
        "version": {
          "const": "0.1.0"
        },
        "registry_schema": {
          "const": "observer-research-index/1.0.0"
        },
        "installed": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "manifest_valid": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "model_valid": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "management_capability": {
          "const": "manage_observer_registry"
        },
        "post_type": {
          "const": "research_output"
        },
        "rest_base": {
          "const": "/wp-json/wp/v2/research"
        },
        "expected_work_count": {
          "const": 5
        },
        "observed_work_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "importer_state_digest": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "productionSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_domain",
        "expected_public_surface",
        "observed_public_surface",
        "checked_at",
        "dns_changed",
        "nameservers_changed",
        "dnssec_changed",
        "domain_assignment_changed",
        "redirects_changed",
        "gravatar_surface_changed",
        "plugin_activated_on_public_domain",
        "research_published_outside_protected_staging",
        "pull_request_merged",
        "production_activation_attempted"
      ],
      "properties": {
        "public_domain": {
          "const": "https://theobserverofmultiverses.info/"
        },
        "expected_public_surface": {
          "const": "GRAVATAR_PROFILE"
        },
        "observed_public_surface": {
          "enum": [
            "GRAVATAR_PROFILE",
            "WORDPRESS_CMS",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "checked_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "dns_changed": {
          "type": "boolean"
        },
        "nameservers_changed": {
          "type": "boolean"
        },
        "dnssec_changed": {
          "type": "boolean"
        },
        "domain_assignment_changed": {
          "type": "boolean"
        },
        "redirects_changed": {
          "type": "boolean"
        },
        "gravatar_surface_changed": {
          "type": "boolean"
        },
        "plugin_activated_on_public_domain": {
          "type": "boolean"
        },
        "research_published_outside_protected_staging": {
          "type": "boolean"
        },
        "pull_request_merged": {
          "type": "boolean"
        },
        "production_activation_attempted": {
          "type": "boolean"
        }
      }
    },
    "backupRestore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkpoint_reference",
        "backup_created_at",
        "restore_target",
        "restore_started_at",
        "restore_completed_at",
        "restore_demonstrated",
        "summary",
        "evidence_refs",
        "database_dump_in_evidence",
        "backup_archive_in_evidence"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/gateStatus"
        },
        "checkpoint_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "backup_created_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "restore_target": {
          "$ref": "#/$defs/nullableUri"
        },
        "restore_started_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "restore_completed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "restore_demonstrated": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "database_dump_in_evidence": {
          "const": false
        },
        "backup_archive_in_evidence": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "restore_demonstrated": {
                "const": true
              },
              "checkpoint_reference": {
                "type": "string",
                "minLength": 1
              },
              "backup_created_at": {
                "type": "string",
                "format": "date-time"
              },
              "restore_target": {
                "type": "string",
                "format": "uri"
              },
              "restore_started_at": {
                "type": "string",
                "format": "date-time"
              },
              "restore_completed_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "applicable",
        "target_host_observation",
        "summary",
        "status_reason",
        "evidence_refs",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/gateStatus"
        },
        "applicable": {
          "type": "boolean"
        },
        "target_host_observation": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status_reason": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "started_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "applicable": {
                "const": true
              },
              "target_host_observation": {
                "const": true
              },
              "evidence_refs": {
                "minItems": 1
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "completed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "SKIP"
              }
            }
          },
          "then": {
            "properties": {
              "applicable": {
                "const": false
              },
              "status_reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          },
          "then": {
            "properties": {
              "target_host_observation": {
                "const": false
              },
              "status_reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "maxItems": 0
              },
              "started_at": {
                "type": "null"
              },
              "completed_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
